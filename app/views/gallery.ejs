<!DOCTYPE html>
<html lang="en" class="scroll-padding">
  <%- include('common/head.ejs', { pageTitle: 'Gallery', bundle: 'gallery' }) %>
  <body>
    <%- include('common/header.ejs') %>
    <main class="main">
      <div class="main-item">
        <h2 class="heading display-5 text-center">Around the Course</h2>
        <% if (photos.length) { %>
          <%- include('partials/gallery-grid.ejs', { photos }) %>
        <% } else { %>
          <p class="text-center">Photos are coming soon.</p>
        <% } %>
      </div>
    </main>
    <dialog class="lightbox" aria-label="Photo viewer">
      <button type="button" class="lightbox-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
      <button type="button" class="lightbox-prev" aria-label="Previous photo"><i class="bi bi-chevron-left"></i></button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      <button type="button" class="lightbox-next" aria-label="Next photo"><i class="bi bi-chevron-right"></i></button>
    </dialog>
    <%- include('common/footer.html') %>
  </body>
</html>
