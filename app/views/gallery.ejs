<!DOCTYPE html>
<html lang="en" class="scroll-padding">
  <%- include('common/head.ejs', { pageTitle: 'Gallery' }) %>
  <body>
    <%- include('common/header.ejs') %>
    <main class="main">
      <div class="main-item">
        <div class="vflex">
          <h2 class="heading display-5 text-center">Around the Course</h2>
          <p class="text-restrict text-center">
            Take a look around Cedar Groves, from the tee boxes and greens to
            the view from above.
          </p>
          <hr class="heading-divider" />
        </div>
        <% if (photos.length) { %>
          <%- include('partials/gallery-grid.ejs', { photos }) %>
        <% } else { %>
          <p class="text-center">Photos are coming soon.</p>
        <% } %>
      </div>
    </main>
    <%- include('partials/lightbox.ejs') %>
    <%- include('common/footer.html') %>
  </body>
</html>
