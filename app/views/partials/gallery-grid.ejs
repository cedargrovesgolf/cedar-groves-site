<div class="gallery-grid">
  <% photos.forEach(photo => { %>
    <button type="button" class="gallery-item" data-full="<%= photo.full %>" data-caption="<%= photo.caption %>">
      <img src="<%= photo.thumb %>" alt="<%= photo.caption || 'Cedar Groves' %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy" />
      <span class="gallery-zoom" aria-hidden="true"><i class="bi bi-arrows-angle-expand"></i></span>
      <% if (photo.caption) { %>
        <span class="gallery-caption"><%= photo.caption %></span>
      <% } %>
    </button>
  <% }) %>
</div>
