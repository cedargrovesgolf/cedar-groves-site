<dialog class="lightbox" aria-label="Photo viewer">
  <button type="button" class="lightbox-button lightbox-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
  <button type="button" class="lightbox-button lightbox-prev" aria-label="Previous photo"><i class="bi bi-chevron-left"></i></button>
  <figure class="lightbox-figure">
    <img alt="" />
    <figcaption class="lightbox-caption"></figcaption>
    <span class="lightbox-count"></span>
  </figure>
  <button type="button" class="lightbox-button lightbox-next" aria-label="Next photo"><i class="bi bi-chevron-right"></i></button>
</dialog>
