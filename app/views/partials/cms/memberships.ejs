<form action="/cms/memberships" method="POST" class="cms-form" novalidate data-async data-cms-form>
  <fieldset class="cms-card">
    <legend class="cms-card-title">Season</legend>
    <div class="cms-price-row">
      <label for="year">Season year</label>
      <input
        type="text"
        class="form-control cms-narrow"
        id="year"
        name="year"
        value="<%= seasonYear %>"
        inputmode="numeric"
        pattern="\d{4}"
        required
        autocomplete="off" />
    </div>
    <% [['Season Pass', 'seasonPass'], ['10-Round Pass', 'tenRoundPass']].forEach(([label, key]) => { %>
      <div class="cms-price-row">
        <label for="<%= key %>"><%= label %></label>
        <div class="input-group cms-price">
          <span class="input-group-text">$</span>
          <input
            type="text"
            class="form-control"
            id="<%= key %>"
            name="<%= key %>"
            value="<%= memberships[key] %>"
            inputmode="decimal"
            pattern="(\d+|\d{1,3}(,\d{3})+)(\.\d{1,2})?"
            required
            autocomplete="off" />
        </div>
      </div>
    <% }) %>
  </fieldset>
  <%- include('save-bar.ejs') %>
</form>
