<form action="/cms/gallery" method="POST" class="cms-form cms-form-gallery" novalidate data-async data-cms-form>
  <input type="hidden" name="version" value="<%= version %>" />
  <div class="cms-card">
    <div class="cms-toolbar">
      <ul class="form-text cms-help">
        <li>Photos appear on the Gallery page in this order. The first one is also the page's main image.</li>
        <li>The first 3 are also shown on the homepage.</li>
        <li>Drag to reorder. Click a photo to edit, or × to delete it.</li>
      </ul>
      <label class="button-3 cms-button">
        <i class="bi bi-upload"></i> Add photos
        <input type="file" accept="image/*" multiple hidden data-upload />
      </label>
    </div>
  </div>

  <div class="cms-tiles" data-tiles data-empty="No photos yet.">
    <% photos.forEach(photo => { %><%- include('gallery-tile.ejs', { photo }) %><% }) %>
  </div>
  <template data-tile-template><%- include('gallery-tile.ejs', { photo: {} }) %></template>

  <dialog class="cms-editor" aria-label="Edit photo">
    <button type="button" class="cms-badge cms-editor-close" aria-label="Close" data-editor-close>
      <i class="bi bi-x-lg"></i>
    </button>
    <img class="cms-editor-image" alt="" />
    <div class="cms-editor-fields">
      <div>
        <label for="edit-name" class="form-label">Name</label>
        <input type="text" class="form-control" id="edit-name" maxlength="100" autocomplete="off" autofocus />
      </div>
      <div>
        <label for="edit-caption" class="form-label">Caption <span class="form-text">(shown under the photo)</span></label>
        <input type="text" class="form-control" id="edit-caption" maxlength="200" autocomplete="off" />
      </div>
      <div class="cms-editor-actions">
        <button type="button" class="button-4 cms-button" data-editor-close>Cancel</button>
        <button type="button" class="button-3 cms-button" data-editor-done>Done</button>
      </div>
    </div>
  </dialog>

  <%- include('save-bar.ejs') %>
</form>
