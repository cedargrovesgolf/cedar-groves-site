<div class="cms-tile" data-full="<%= photo.full %>">
  <input type="hidden" name="id" value="<%= photo.id %>" />
  <input type="hidden" name="name" value="<%= photo.name ?? '' %>" />
  <input type="hidden" name="caption" value="<%= photo.caption ?? '' %>" />
  <input type="hidden" name="width" value="<%= photo.width %>" />
  <input type="hidden" name="height" value="<%= photo.height %>" />
  <button type="button" class="cms-tile-image" aria-label="Edit photo">
    <img src="<%= photo.thumb %>" alt="" loading="lazy" />
    <span class="cms-tile-badges"><span class="cms-badge cms-tile-number"></span></span>
    <span class="cms-tile-caption"></span>
  </button>
  <button type="button" class="cms-badge cms-tile-delete" aria-label="Delete photo">
    <i class="bi bi-x-lg"></i>
  </button>
  <span class="cms-tile-name"></span>
</div>
