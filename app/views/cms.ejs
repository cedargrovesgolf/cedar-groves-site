<!DOCTYPE html>
<html lang="en">
  <%- include('common/head.ejs', { pageTitle: loggedIn ? `CMS ${title}` : 'CMS', bundle: loggedIn ? 'cms' : null }) %>
  <body <% if (loggedIn) { %>class="cms-page"<% } %>>
    <% if (!loggedIn) { %>
      <main class="main">
        <%- include('partials/cms/login.ejs') %>
      </main>
    <% } else { %>
      <header class="cms-bar">
        <a href="/cms" class="logo">Cedar Groves</a>
        <div class="cms-bar-actions">
          <a href="/" target="_blank" rel="noopener" class="cms-bar-link" aria-label="View site">
            <span class="cms-bar-label">View site</span> <i class="bi bi-box-arrow-up-right"></i>
          </a>
          <form method="post" action="/cms/logout">
            <button type="submit" class="cms-bar-link" aria-label="Log out">
              <span class="cms-bar-label">Log out</span> <i class="bi bi-box-arrow-right"></i>
            </button>
          </form>
        </div>
      </header>
      <div class="cms-layout">
        <nav class="cms-nav" aria-label="Sections">
          <% sections.forEach(({ key, title }) => { %>
            <a href="/cms/<%= key %>" <% if (key === section) { %>aria-current="page"<% } %>><%= title %></a>
          <% }) %>
        </nav>
        <main class="cms-content">
          <h1 class="cms-title"><%= title %></h1>
          <%- include(`partials/cms/${section}.ejs`) %>
        </main>
      </div>
    <% } %>
  </body>
</html>
