<header
  class="background-img position-relative"
  style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.1)),
      url('<%= heroImg %>'); height: 100vh;">
  <div class="vflex position-absolute top-50 start-50 translate-middle w-100 color-w">
    <h1 class="hero-heading display-4 text-center" style="line-height: 1; white-space: pre-line"><%= heroTitle %></h1>
    <hr class="hero-divider opacity-100" />
    <h5 class="hero-sub" style="font-style: italic"><%= heroSubtitle %></h5>
  </div>
  <div class="nav-area navbar navbar-expand p-3 transition">
    <nav class="navbar-content container-fluid">
      <a href="/" class="logo vflex">
        <img src="/assets/logo.svg" alt="" width="150" height="60" />
        <span>Cedar Groves</span>
      </a>
      <button
        class="nav-button font-xl"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#mobile-nav">
        <i id="menu-button" class="bi bi-list"></i>
      </button>
      <div class="navbar-wrapper"><%- include('nav-links.html') %></div>
    </nav>
  </div>
  <div class="nav-area offcanvas offcanvas-start bg-acc" id="mobile-nav">
    <nav class="container-fluid">
      <div class="offcanvas-header">
        <a href="/" class="logo vflex">
          <img src="/assets/logo.svg" alt="" width="110" height="44" />
          <span style="font-size: 24px">Cedar Groves</span>
        </a>
        <button
          class="nav-button font-xl"
          type="button"
          data-bs-dismiss="offcanvas"
          data-bs-target="#mobile-nav">
          <i id="close-button" class="bi bi-x" style="font-size: 42px"></i>
        </button>
      </div>
      <div class="offcanvas-body"><%- include('nav-links.html') %></div>
    </nav>
  </div>
</header>
<script nonce="<%= cspNonce %>">
  {
    const menuButton = document.getElementById('menu-button')
    const mobileNav = document.getElementById('mobile-nav')
    const navbar = document.querySelector('.navbar')
    const updateNavbar = () => navbar.classList.toggle('navbar-sticky', window.scrollY >= 48)
    mobileNav.addEventListener('show.bs.offcanvas', () => menuButton.classList.add('opacity-0'))
    mobileNav.addEventListener('hide.bs.offcanvas', () => menuButton.classList.remove('opacity-0'))
    window.addEventListener('scroll', updateNavbar, { passive: true })
    updateNavbar()
  }
</script>