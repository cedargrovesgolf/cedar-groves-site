  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/cormorant-infant": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sortablejs": "^1.15.7",
